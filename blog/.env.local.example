# Supabase project URL (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Settings > API Keys) - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (Settings > API Keys) - server-only, never expose to the browser
SUPABASE_SECRET_KEY=

# Allowlisted admin email - the only account proxy.ts will let into /admin/*
ADMIN_EMAIL=
